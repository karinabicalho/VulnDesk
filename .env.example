# Front-end (públicas — chave "anon"/"publishable" do Supabase)
VITE_SUPABASE_URL=https://<projeto>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-ou-publishable-key>

# Servidor / build (secretas — configure na Vercel, nunca no código)
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
POSTGRES_URL_NON_POOLING=postgres://...

# Contas provisionadas no deploy (scripts/db-setup.mjs)
VULNDESK_ADMIN_EMAIL=admin@vulndesk.app
VULNDESK_ADMIN_PASSWORD=<senha-forte>
VULNDESK_PROFESSOR_EMAIL=professor@vulndesk.app
VULNDESK_PROFESSOR_PASSWORD=<senha-forte>
VULNDESK_DEMO_PASSWORD=<senha-das-contas-de-demonstracao>
